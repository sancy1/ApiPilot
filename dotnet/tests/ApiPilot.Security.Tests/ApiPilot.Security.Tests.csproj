<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ApiPilot.Security.Tests - the security test harness.
    Uses the repository-local reflection runner, not a test SDK.
    No PackageReference entries. The audit enforces this.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ApiPilot.Security.Tests</AssemblyName>
    <RootNamespace>ApiPilot.Security.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApiPilot.Security\ApiPilot.Security.csproj" />
    <ProjectReference Include="..\..\src\ApiPilot.Core\ApiPilot.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="..\ApiPilot.TestHarness\TestHarness.cs" Link="TestHarness.cs" />
  </ItemGroup>
</Project>

