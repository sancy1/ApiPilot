  <ItemGroup>
    <InternalsVisibleTo Include="ApiPilot.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
