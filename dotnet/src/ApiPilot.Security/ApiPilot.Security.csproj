<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ApiPilot.Security - the security core for ApiPilot.
    No PackageReference entries. The only external dependency is the
    Microsoft.AspNetCore.App framework reference, which is part of the
    .NET platform, not a third-party package. The audit enforces this.
  -->

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyName>ApiPilot.Security</AssemblyName>
    <RootNamespace>ApiPilot.Security</RootNamespace>
    <PackageId>ApiPilot.Security</PackageId>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Description>CSRF protection, secure cookie profiles, Origin policy, and Fetch Metadata for ApiPilot. Requires ApiPilot.Core and ApiPilot.AspNetCore. See the full boundary at https://github.com/sancy1/ApiPilot.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiPilot.Security.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiPilot.Core\ApiPilot.Core.csproj" />
    <ProjectReference Include="..\ApiPilot.AspNetCore\ApiPilot.AspNetCore.csproj" />
  </ItemGroup>


  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

